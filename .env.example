# ============================================================
# MS-Automatizar — .env.example
# ============================================================
# Copie para .env e edite as senhas ANTES de subir:
#   cp .env.example .env
#
# Os serviços NÃO sobem sem as variáveis obrigatórias marcadas com
# "${VAR:?...}" no docker-compose.yml.
# ============================================================

# IP de bind das portas (opcional).
# Deixe vazio para expor apenas no localhost (127.0.0.1) ou
# defina o IP da sua rede privada/VPN para acesso remoto.
# BIND_IP=

# ---------- MongoDB 8.0 ----------
MONGO_ROOT_USERNAME=seu_usuario
MONGO_ROOT_PASSWORD=sua_senha_forte
MONGO_PORT=27017

# ---------- Redis 7.2 ----------
REDIS_PASSWORD=sua_senha_forte
REDIS_PORT=6379

# ---------- WhatsApp API (go-whatsapp) ----------
# Formato usuario:senha (usado como Basic Auth pela API)
WHATSAPP_BASIC_AUTH=seu_usuario:sua_senha_forte
WHATSAPP_PORT=3001
