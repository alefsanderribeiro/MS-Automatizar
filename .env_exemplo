# ==================== Configurações do MS-Automatizar ====================
# Copie este arquivo para .env e configure os valores

# ==================== MongoDB ====================
# URI de conexão com MongoDB
MONGO_URI="mongodb://localhost:27017"
# Nome do banco de dados
MONGO_DATABASE_NAME="MS_Automatizar"
# Tamanho do pool de conexões
MONGO_MAX_POOL_SIZE="10"
MONGO_MIN_POOL_SIZE="1"

# ==================== APIs de IA ====================
# Chave de API do Google Gemini (para processamento de PDFs com IA)
# Obtenha em: https://makersuite.google.com/app/apikey
KEY_API_GEMINI=""

# Chave de API do Mistral AI (alternativa)
KEY_API_MISTRAL=""

# ==================== OpenCode (Zen/Go) ====================
# Chave obtida em https://opencode.ai/auth (Go e Zen usam a mesma chave)
KEY_API_OPENCODE=""
# Go usa https://opencode.ai/zen/go/v1 ; Zen usa https://opencode.ai/zen/v1
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"
# Modelos de visão: mimo-v2.5, mimo-v2-omni, qwen3.7-plus, qwen3.6-plus, qwen3.5-plus
OPENCODE_MODEL_OCR="mimo-v2.5"
OPENCODE_MODEL_AI="mimo-v2.5"
# Ordem de fallback dos provedores de IA (opencode, gemini, mistral)
IA_EXTRATORES="opencode,gemini,mistral"

# ==================== Sistema ====================
# Modo de operação: mongodb, excel ou ambos
# - mongodb: Usar apenas MongoDB (recomendado)
# - excel: Usar apenas planilhas Excel (legado)
# - ambos: Usar MongoDB e Excel simultaneamente
MODO_OPERACAO="mongodb"

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# Diretório padrão para salvar arquivos gerados (opcional)
DIRETORIO_SAIDA=""

# ==================== Zoho Mail ====================
# Credenciais OAuth2 do Zoho Mail
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNT_ID=""
ZOHO_EMAIL_FROM=""
# Domínio da API: com, eu, in, com.cn, com.au, jp
ZOHO_API_DOMAIN="com"

# ==================== WhatsApp ====================
# URL da API do WhatsApp (go-whatsapp-web-multidevice)
WHATSAPP_API_URL="http://localhost:3000"
WHATSAPP_API_KEY=""

# ==================== Redis (opcional) ====================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_ENABLED="true"
REDIS_DB="0"

# ==================== Performance ====================
# Tempo de vida do cache em segundos (padrão: 300)
CACHE_TTL="300"
# Número máximo de tentativas de envio
ENVIO_MAX_TENTATIVAS="3"
# Delay entre retentativas em segundos
ENVIO_RETRY_DELAY_SECONDS="5"

# ==================== Planilhas ====================
# Caminhos personalizados para planilhas (opcional)
PLANILHA_CONTATOS_PATH=""
PLANILHA_HOLERITES_PATH=""

# ==================== OneDrive (opcional) ====================
# URLs das planilhas compartilhadas no OneDrive
# Necessário apenas se MODO_OPERACAO = excel ou ambos
ONEDRIVE_URL_DADOS=""
ONEDRIVE_URL_MODELOS=""
